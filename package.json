{
    "name": "memory-harness",
    "private": true,
    "imports": {
        "#/*": "./src/*"
    },
    "version": "1.0.0",
    "scripts": {
        "dev": "vite dev --port 3000",
        "generate-routes": "tsr generate",
        "build": "vite build",
        "preview": "vite preview",
        "format": "biome format",
        "lint": "biome lint",
        "check": "biome check",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "wrangler d1 migrations apply memory-harness --local",
        "db:migrate:remote": "wrangler d1 migrations apply memory-harness --remote",
        "db:push": "drizzle-kit push",
        "db:pull": "drizzle-kit pull",
        "db:studio": "drizzle-kit studio",
        "deploy": "rm -rf dist && pnpm build && wrangler deploy"
    },
